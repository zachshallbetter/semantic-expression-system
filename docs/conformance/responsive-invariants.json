  "invariants": ["RESP-001","RESP-002","RESP-003","RESP-004","RESP-005","RESP-006","RESP-007","RESP-008"],
  "failureCodes": ["ERR_CONTENT_UNREACHABLE","ERR_CONTENT_CLIPPED","ERR_COMPOSITION_OVERFLOW","ERR_KEYBOARD_ORDER_MISMATCH","ERR_OPERATION_NOT_EXPOSED","ERR_A11Y_FALLBACK_MISSING"]
}
