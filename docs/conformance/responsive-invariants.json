{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "SES-008",
  "title": "SES Responsive Invariants",
  "status": "Canonical Contract",
  "contexts": ["wide", "narrow", "small-touch", "reduced-motion", "high-contrast"],
  "mutations": {
