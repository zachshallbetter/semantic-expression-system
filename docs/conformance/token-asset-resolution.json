{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "SES-010",
  "title": "SES Token and Asset Resolution",
  "status": "Canonical Contract",
  "tokenLayers": ["primitive", "semantic", "role", "recipe", "explicit-expression-override", "resolved"],
  "assetCategories": ["fonts", "icons", "images", "textures", "patterns", "masks", "edges", "backgrounds", "ornaments", "custom"],
