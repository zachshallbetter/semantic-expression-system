{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ses/1.0.0/ses.schema.json",
  "title": "Semantic Expression System",
  "type": "object",
  "required": ["version", "kind", "id"],
  "properties": {
    "version": { "const": "1.0.0" },
    "kind": {
      "enum": [
        "element",
        "block",
        "socket",
        "composition",
        "visual-language",
        "theme",
        "projection-contract",
        "recipe"
      ]
    },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "semanticRole": { "type": "string" },
    "slots": { "type": "array" },
    "sockets": { "type": "array" },
    "accepts": { "type": "array" },
    "invariance": { "$ref": "#/$defs/invariance" },
    "projection": { "$ref": "#/$defs/projection" },
    "operations": { "$ref": "#/$defs/operations" },
    "layout": { "type": "object", "additionalProperties": true },
    "morphology": { "$ref": "#/$defs/morphology" },
    "appearance": { "$ref": "#/$defs/appearance" },
    "tokens": { "type": "object", "additionalProperties": true },
    "assets": { "type": "object", "additionalProperties": true },
    "recipes": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "requirement": {
      "enum": ["required", "bounded", "free"]
    },
    "invariance": {
      "type": "object",
      "properties": {
        "semantic": { "$ref": "#/$defs/requirement" },
        "behavioral": { "$ref": "#/$defs/requirement" },
        "actionIdentity": { "$ref": "#/$defs/requirement" },
        "structural": { "$ref": "#/$defs/requirement" },
        "morphological": { "$ref": "#/$defs/requirement" },
        "visual": { "$ref": "#/$defs/requirement" }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "properties": {
        "preserve": { "type": "array", "items": { "type": "string" } },
        "transform": { "type": "array", "items": { "type": "string" } },
        "mayOmit": { "type": "array", "items": { "type": "string" } },
        "mayIntroduce": { "type": "array", "items": { "type": "string" } },
        "failureConditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } },
        "requireExposure": { "type": "boolean" },
        "requireSignaling": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "morphology": {
      "type": "object",
      "properties": {
        "hierarchy": { "type": "string" },
        "topology": { "type": "string" },
        "density": { "type": "string" },
        "rhythm": { "type": "string" },
        "alignment": { "type": "string" },
        "symmetry": { "type": "string" },
        "enclosure": { "type": "string" },
        "continuity": { "type": "string" },
        "direction": { "type": "string" },
        "overlap": { "type": "string" },
        "fragmentation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "appearance": {
      "type": "object",
      "properties": {
        "background": { "type": "array", "items": { "$ref": "#/$defs/backgroundLayer" } },
        "textures": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "patterns": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edgeLayer" } },
        "decorations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "mask": {},
        "clip": {},
        "bleed": { "type": "object", "additionalProperties": { "type": "string" } },
        "overflow": { "enum": ["visible", "hidden", "clip"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blendMode": { "type": "string" },
        "filter": { "type": "string" },
        "backdrop": { "type": "string" }
      },
      "additionalProperties": true
    },
    "backgroundLayer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["color", "gradient", "texture", "pattern", "image", "custom"] },
        "value": { "type": "string" },
        "source": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blendMode": { "type": "string" },
        "mask": { "type": "string" },
        "fit": { "type": "string" },
        "position": { "type": "string" }
      },
      "additionalProperties": true
    },
    "edgeLayer": {
      "type": "object",
      "required": ["sides", "style"],
      "properties": {
        "sides": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "items": { "enum": ["top", "right", "bottom", "left"] }, "minItems": 1 }
          ]
        },
        "style": { "type": "string" },
        "width": { "type": "string" },
        "color": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string" },
        "offset": { "type": "string" },
        "inset": { "type": "boolean" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "repeat": { "enum": ["stretch", "repeat", "round"] },
        "mask": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
